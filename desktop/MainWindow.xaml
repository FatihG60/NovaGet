<Window x:Class="MyIdm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NovaGet"
        Icon="Assets/icon.png"
        Width="1080" Height="720"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0A0B0E"
        Foreground="#EDEDEF"
        FontFamily="Segoe UI Variable Text, Inter, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Neutral Secondary Button (Carbon-Slate Monochrome) -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#171A24"/>
            <Setter Property="Foreground" Value="#D4D7E0"/>
            <Setter Property="BorderBrush" Value="#262B38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2230"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#353C4F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#12141C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Cobalt Action Button (10% Single Accent Rule — No Gradients) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Ghost Toolbar Button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8F9E"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#171A24"/>
                                <Setter Property="Foreground" Value="#EDEDEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Genuine Horizontal Underline Filter Tab Styles -->
        <Style x:Key="FilterTabInactive" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8F9E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EDEDEF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#282E3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTabActive" TargetType="Button" BasedOn="{StaticResource FilterTabInactive}">
            <Setter Property="Foreground" Value="#EDEDEF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="#3B82F6"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TitleBar Window Control Buttons -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8F9E"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2230"/>
                                <Setter Property="Foreground" Value="#EDEDEF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282E3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox & ComboBoxItem Styles -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#14171F"/>
            <Setter Property="Foreground" Value="#EDEDEF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2230"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#14171F"/>
            <Setter Property="Foreground" Value="#EDEDEF"/>
            <Setter Property="BorderBrush" Value="#262B38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#14171F"
                                                BorderBrush="#262B38"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#8A8F9E"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#181C26"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#353C4F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#14171F"
                                        BorderBrush="#282E3D"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="3"
                                        Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark System Tray ContextMenu & MenuItem Styles -->
        <Style x:Key="TrayContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#0F1117"
                                BorderBrush="#262B38"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="5"
                                Margin="10"
                                MinWidth="210">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Background="#14171F" BorderBrush="#1C202B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,4">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="Assets/icon.png" Width="15" Height="15" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="NovaGet" Foreground="#EDEDEF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Aktif" Foreground="#8A8F9E" FontSize="10.5" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#D4D7E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="10,7"
                                Margin="0,1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2230"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2230"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayDangerMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource TrayMenuItemStyle}">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="10,7"
                                Margin="0,1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A1215"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A1215"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TraySeparatorStyle" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1C202B" Margin="4,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crisp 4px Linear Progress Bar -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#171A24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ListBoxItem Container (No default blue highlight box) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootWindowBorder"
            Background="#0A0B0E"
            BorderBrush="#1C202B"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. NATIVE-GRADE TOP CHROME (38px, Zero Marketing Slop, Vector Controls) -->
            <Border Grid.Row="0"
                    Background="#0F1117"
                    BorderBrush="#1C202B"
                    BorderThickness="0,0,0,1"
                    Padding="14,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Identity -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/icon.png" Width="16" Height="16" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="NovaGet"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#EDEDEF"
                                   VerticalAlignment="Center"/>
                        <Border Width="1" Height="12" Background="#262B38" Margin="10,0"/>
                        <TextBlock Text="Download &amp; Stream Engine"
                                   FontSize="11.5"
                                   Foreground="#565B6A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Telemetry, Bridge Status, Settings & Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Live Throughput Telemetry Badge (Tabular Monospace) -->
                        <Border Background="#14171F" BorderBrush="#1C202B" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconActivity}"
                                      Stroke="#3B82F6"
                                      StrokeThickness="1.5"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="TotalSpeedBadge" Text="0,00 MB/sn"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#EDEDEF"/>
                            </StackPanel>
                        </Border>

                        <!-- Browser Bridge Status Indicator -->
                        <Border Background="#14171F" BorderBrush="#1C202B" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock x:Name="BridgeStatusText" Text="Tarayıcı Bağlı"
                                           FontSize="11" FontWeight="Medium" Foreground="#8A8F9E"/>
                            </StackPanel>
                        </Border>

                        <!-- Vector Settings Button -->
                        <Button Style="{StaticResource ModernButton}"
                                Height="26" Padding="9,0" Margin="0,0,8,0"
                                ToolTip="Uygulama Ayarları"
                                Click="OnOpenSettingsClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}"
                                      Stroke="#8A8F9E"
                                      StrokeThickness="1.5"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Ayarlar" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Hairline Divider -->
                        <Border Width="1" Height="16" Background="#1C202B" Margin="0,0,4,0"/>

                        <!-- Window Controls -->
                        <Button Style="{StaticResource WindowControlButton}"
                                ToolTip="Sistem Tepsisine Küçült"
                                Click="OnMinimizeToTrayClick">
                            <Path Data="{StaticResource IconTrayMinimize}"
                                  Stroke="#8A8F9E"
                                  StrokeThickness="1.5"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource WindowControlButton}"
                                Content="─"
                                ToolTip="Simge Durumuna Küçült"
                                Click="OnMinimizeWindowClick"/>

                        <Button x:Name="MaxRestoreBtn"
                                Style="{StaticResource WindowControlButton}"
                                Content="▢"
                                ToolTip="Tam Ekran / Önceki Boyut"
                                Click="OnMaximizeRestoreWindowClick"/>

                        <Button Style="{StaticResource CloseWindowButton}"
                                Content="✕"
                                ToolTip="Kapat"
                                Click="OnCloseWindowClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN WORKSPACE -->
            <Grid Grid.Row="1" Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- A. SINGLE-ROW COMMAND BAR (URL Input + Quality + Download CTA) -->
                <Border Grid.Row="0"
                        Background="#0F1117"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,12"
                        BorderBrush="#1C202B"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- URL Input Box -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="UrlInputBox"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Background="#0A0B0E"
                                     Foreground="#EDEDEF"
                                     CaretBrush="#3B82F6"
                                     BorderBrush="#262B38"
                                     BorderThickness="1"
                                     Padding="10,0,84,0"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12"
                                     TextChanged="OnUrlInputTextChanged"/>
                            <TextBlock x:Name="UrlPlaceholderText"
                                       Text="Video, HLS (.m3u8) veya doğrudan dosya bağlantısını yapıştırın..."
                                       Foreground="#565B6A"
                                       FontSize="12"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Button Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Height="26" Padding="8,0" Margin="0,0,4,0"
                                    Click="OnPasteUrlClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClipboard}"
                                          Stroke="#8A8F9E"
                                          StrokeThickness="1.5"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Yapıştır" FontSize="11" Foreground="#8A8F9E" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Quality Selector (Zero Emojis) -->
                        <ComboBox x:Name="QualityCombo"
                                  Style="{StaticResource DarkComboBox}"
                                  Grid.Column="1"
                                  Width="156" Height="34"
                                  Margin="8,0,0,0"
                                  VerticalContentAlignment="Center"
                                  SelectedIndex="0"
                                  FontSize="12"
                                  ToolTip="Medya Kalitesi">
                            <ComboBoxItem Content="En İyi Kalite (Auto)" Tag="best"/>
                            <ComboBoxItem Content="1080p Full HD" Tag="1080"/>
                            <ComboBoxItem Content="720p HD" Tag="720"/>
                            <ComboBoxItem Content="480p SD" Tag="480"/>
                            <ComboBoxItem Content="Yalnızca Ses (MP3)" Tag="audio"/>
                        </ComboBox>

                        <!-- Primary Cobalt Download CTA -->
                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Height="34" Padding="16,0" Margin="8,0,0,0"
                                FontSize="12"
                                Click="OnStartDownloadClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.6"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="İndir" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- B. GENUINE UNDERLINE FILTER TAB STRIP & VECTOR QUICK ACTIONS -->
                <Border Grid.Row="1"
                        BorderBrush="#1C202B"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Underline Filter Tabs -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="FilterAllBtn"
                                    Style="{StaticResource FilterTabActive}"
                                    Content="Tümü"
                                    Tag="all"
                                    Click="OnFilterTabClick"/>
                            <Button x:Name="FilterActiveBtn"
                                    Style="{StaticResource FilterTabInactive}"
                                    Content="Aktif"
                                    Tag="active"
                                    Click="OnFilterTabClick"/>
                            <Button x:Name="FilterCompletedBtn"
                                    Style="{StaticResource FilterTabInactive}"
                                    Content="Tamamlanan"
                                    Tag="completed"
                                    Click="OnFilterTabClick"/>

                            <Border Background="#14171F" BorderBrush="#1C202B" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,0,0,5" VerticalAlignment="Center">
                                <TextBlock x:Name="QueueCountBadge" Text="0 Görev" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#8A8F9E"/>
                            </Border>
                        </StackPanel>

                        <!-- Right: Vector Toolbar Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Button x:Name="ToggleSegmentsBtn"
                                    Style="{StaticResource GhostButton}"
                                    Height="26" Padding="9,0" Margin="0,0,4,0"
                                    Click="OnToggleSegmentPanelClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconActivity}"
                                          Stroke="#8A8F9E"
                                          StrokeThickness="1.5"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Bağlantı Telemetrisi" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}"
                                    Height="26" Padding="9,0" Margin="0,0,4,0"
                                    Click="OnOpenDownloadsFolderClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}"
                                          Stroke="#8A8F9E"
                                          StrokeThickness="1.5"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Klasörü Aç" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}"
                                    Height="26" Padding="9,0"
                                    Click="OnClearCompletedClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}"
                                          Stroke="#8A8F9E"
                                          StrokeThickness="1.5"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Temizle" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- C. HIGH-DENSITY 1PX-HAIRLINE DOWNLOAD LIST -->
                <Border Grid.Row="2"
                        Background="#0A0B0E"
                        CornerRadius="6"
                        BorderBrush="#1C202B"
                        BorderThickness="1">
                    <Grid>
                        <ListBox x:Name="DownloadsListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnDownloadSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ItemRowBorder"
                                            Background="#0F1117"
                                            BorderBrush="#1C202B"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12,9"
                                            Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Title, 4px Progress Bar, Telemetry Metadata -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <!-- Row 1: Monochrome Type Badge + File Name + Tabular Speed & Percent -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Background="#171A24"
                                                            BorderBrush="#262B38"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="5,1"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CategoryText}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#8A8F9E"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FileName}"
                                                               FontWeight="Medium"
                                                               FontSize="12.5"
                                                               Foreground="#EDEDEF"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding SpeedText}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11.5"
                                                                   Foreground="#8A8F9E"
                                                                   Margin="0,0,12,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ProgressPercent, StringFormat=%{0:F1}}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11.5"
                                                                   Foreground="#EDEDEF"
                                                                   Width="48"
                                                                   TextAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 2: 4px Linear Progress Bar -->
                                                <ProgressBar Style="{StaticResource ModernProgressBar}"
                                                             Value="{Binding ProgressPercent}"
                                                             Maximum="100"
                                                             Foreground="{Binding StatusBrush}"
                                                             Margin="0,0,0,6"/>

                                                <!-- Row 3: Status, Size, Segments & ETA -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}" FontWeight="Medium" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding SizeText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8A8F9E"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SegmentsSummary}" FontSize="11" Foreground="#565B6A" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding EtaText, StringFormat=ETA {0}}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#565B6A"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Right: Vector Action & Remove Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ModernButton}"
                                                        Tag="{Binding}"
                                                        Height="28"
                                                        Padding="10,0"
                                                        Click="OnItemActionClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{Binding ActionIconData}"
                                                              Stroke="#D4D7E0"
                                                              StrokeThickness="1.5"
                                                              Width="11" Height="11"
                                                              Stretch="Uniform"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ActionButtonText}" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}"
                                                        Tag="{Binding}"
                                                        Width="28" Height="28"
                                                        Margin="4,0,0,0"
                                                        ToolTip="Listeden Kaldır"
                                                        Click="OnRemoveItemClick">
                                                    <Path Data="{StaticResource IconClose}"
                                                          Stroke="#8A8F9E"
                                                          StrokeThickness="1.5"
                                                          Width="11" Height="11"
                                                          Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="ItemRowBorder" Property="Background" Value="#14171F"/>
                                            <Setter TargetName="ItemRowBorder" Property="BorderBrush" Value="#282E3D"/>
                                        </DataTrigger>
                                        <Trigger SourceName="ItemRowBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemRowBorder" Property="BorderBrush" Value="#282E3D"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Clean Empty State -->
                        <Grid x:Name="EmptyStatePanel" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#14171F" BorderBrush="#1C202B" BorderThickness="1" CornerRadius="8" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="{StaticResource IconDownload}"
                                          Stroke="#8A8F9E"
                                          StrokeThickness="1.5"
                                          Width="18" Height="18"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="İndirme Kuyruğu Boş" FontSize="13.5" FontWeight="SemiBold" Foreground="#EDEDEF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tarayıcıdan bir medya yakalayın veya yukarıdaki alana bağlantı yapıştırın."
                                           FontSize="12" Foreground="#565B6A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- D. COLLAPSIBLE SEGMENT & STREAM TELEMETRY INSPECTOR -->
                <Border x:Name="SegmentInspectorPanel"
                        Grid.Row="3"
                        Visibility="Collapsed"
                        Height="160"
                        Background="#0F1117"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,10,0,0"
                        BorderBrush="#1C202B"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconActivity}"
                                      Stroke="#3B82F6"
                                      StrokeThickness="1.5"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,7,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="InspectorTitleText"
                                           Text="Bağlantı ve Akış Telemetrisi"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#EDEDEF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Gizle"
                                    HorizontalAlignment="Right"
                                    Height="22" Padding="8,0" FontSize="11"
                                    Click="OnToggleSegmentPanelClick"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SegmentsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#14171F"
                                                BorderBrush="#1C202B"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,5"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="185"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="155"/>
                                                    <ColumnDefinition Width="165"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat=Akış #{0}}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" FontSize="11" Foreground="#EDEDEF" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RangeText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8A8F9E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Column="2"
                                                             Style="{StaticResource ModernProgressBar}"
                                                             Value="{Binding ProgressPercent}"
                                                             Maximum="100"
                                                             Margin="12,0"
                                                             Foreground="{Binding BarBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DownloadedText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#8A8F9E" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding StatusBadge}" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Medium" Foreground="{Binding BarBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. SETTINGS MODAL OVERLAY (Carbon-Slate Monochrome) -->
            <Grid x:Name="SettingsModalOverlay"
                  Grid.Row="1"
                  Background="#CC060709"
                  Visibility="Collapsed">
                <Border Width="500"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#0F1117"
                        BorderBrush="#262B38"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22,18">
                    <StackPanel>
                        <!-- Header -->
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}"
                                      Stroke="#8A8F9E"
                                      StrokeThickness="1.5"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Uygulama Ayarları" FontSize="14.5" FontWeight="SemiBold" Foreground="#EDEDEF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="✕"
                                    HorizontalAlignment="Right"
                                    Width="26" Height="26" FontSize="12"
                                    Click="OnCloseSettingsClick"/>
                        </DockPanel>

                        <!-- 1. Download Directory -->
                        <TextBlock Text="İndirme Kayıt Klasörü" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8F9E" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SettingsDirBox"
                                     Grid.Column="0"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Background="#0A0B0E"
                                     Foreground="#EDEDEF"
                                     BorderBrush="#262B38"
                                     BorderThickness="1"
                                     Padding="10,0"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11.5"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ModernButton}"
                                    Content="Klasörü Aç"
                                    Height="32" Padding="12,0" Margin="8,0,0,0"
                                    FontSize="11.5"
                                    Click="OnOpenDownloadsFolderClick"/>
                        </Grid>

                        <!-- 2. Default Connections & Quality -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Paralel Bağlantı Sayısı" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8F9E" Margin="0,0,0,5"/>
                                <ComboBox x:Name="SettingsConnectionsCombo"
                                          Style="{StaticResource DarkComboBox}"
                                          Height="32"
                                          SelectedIndex="2"
                                          FontSize="12">
                                    <ComboBoxItem Content="1 Bağlantı (Standart)" Tag="1"/>
                                    <ComboBoxItem Content="4 Bağlantı (Hızlı)" Tag="4"/>
                                    <ComboBoxItem Content="8 Bağlantı (Önerilen)" Tag="8"/>
                                    <ComboBoxItem Content="16 Bağlantı (Yüksek Hız)" Tag="16"/>
                                    <ComboBoxItem Content="32 Bağlantı (Maksimum)" Tag="32"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Varsayılan Medya Kalitesi" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8F9E" Margin="0,0,0,5"/>
                                <ComboBox x:Name="SettingsQualityCombo"
                                          Style="{StaticResource DarkComboBox}"
                                          Height="32"
                                          SelectedIndex="0"
                                          FontSize="12">
                                    <ComboBoxItem Content="En İyi Kalite (4K/1080p)" Tag="best"/>
                                    <ComboBoxItem Content="1080p Full HD" Tag="1080"/>
                                    <ComboBoxItem Content="720p HD" Tag="720"/>
                                    <ComboBoxItem Content="480p SD" Tag="480"/>
                                    <ComboBoxItem Content="Yalnızca Ses (MP3)" Tag="audio"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 3. Behavior Checkboxes -->
                        <TextBlock Text="Sistem Davranışı" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8F9E" Margin="0,0,0,6"/>
                        <Border Background="#0A0B0E" BorderBrush="#1C202B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="MinimizeToTrayCheck"
                                          Content="Pencere kapatıldığında Sistem Tepsisine küçült"
                                          IsChecked="True"
                                          Foreground="#D4D7E0"
                                          FontSize="12"
                                          Margin="0,0,0,8"
                                          Cursor="Hand"/>
                                <CheckBox x:Name="NotifyOnCompleteCheck"
                                          Content="İndirme tamamlandığında masaüstü bildirimi göster"
                                          IsChecked="True"
                                          Foreground="#D4D7E0"
                                          FontSize="12"
                                          Margin="0,0,0,8"
                                          Cursor="Hand"/>
                                <CheckBox x:Name="AutoStartBrowserCheck"
                                          Content="Tarayıcı eklentisinden gelen indirmeleri otomatik başlat"
                                          IsChecked="True"
                                          Foreground="#D4D7E0"
                                          FontSize="12"
                                          Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Diagnostics -->
                        <TextBlock Text="Tanılama ve Motor Testleri" FontSize="11.5" FontWeight="SemiBold" Foreground="#8A8F9E" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button Style="{StaticResource ModernButton}"
                                    Content="128 MB Segment Hız Testi"
                                    Height="30" Padding="12,0" Margin="0,0,8,0"
                                    FontSize="11.5"
                                    Click="OnStart128MbDemoClick"/>
                            <Button Style="{StaticResource ModernButton}"
                                    Content="HLS (.m3u8) Akış Testi"
                                    Height="30" Padding="12,0"
                                    FontSize="11.5"
                                    Click="OnStartHlsDemoClick"/>
                        </StackPanel>

                        <!-- Save Button -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Ayarları Kaydet"
                                Height="34"
                                FontSize="12.5"
                                Click="OnSaveSettingsClick"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
