<Window x:Class="MyIdm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NovaGet"
        Icon="Assets/icon.png"
        Width="1060" Height="720"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080C16"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Secondary Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#162032"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#23324B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost / Filter Tab Button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#162032"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TitleBar Window Control Buttons -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0284C7" Offset="0.0"/>
                        <GradientStop Color="#2563EB" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Dark ComboBox & ComboBoxItem Styles -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#162032"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#23324B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#162032"
                                                BorderBrush="#23324B"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#38BDF8"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#0F172A"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4"
                                        Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Progress Bar -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#090D16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3.5" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3.5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootWindowBorder"
            Background="#080C16"
            BorderBrush="#1E293B"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. SADE VE MODERN CUSTOM HEADER / TITLE BAR -->
            <Border Grid.Row="0"
                    Background="#0B101E"
                    BorderBrush="#162032"
                    BorderThickness="0,0,0,1"
                    Padding="16,9"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: İkon ve Marka -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="28" Height="28" Margin="0,0,10,0" ClipToBounds="True"
                                BorderBrush="#0284C7" BorderThickness="1">
                            <Image Source="Assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="NovaGet"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Sağ: Hız Göstergesi, Köprü Durumu, Ayarlar ve Pencere Tuşları -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Canlı Hız Rozeti -->
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="7" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock x:Name="TotalSpeedBadge" Text="⚡ 0,00 MB/sn"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>

                        <!-- Tarayıcı Köprüsü Durumu -->
                        <Border Background="#072E25" BorderBrush="#065F46" BorderThickness="1" CornerRadius="7" Padding="10,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0"/>
                                <TextBlock x:Name="BridgeStatusText" Text="Tarayıcı Bağlı"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399"/>
                            </StackPanel>
                        </Border>

                        <!-- Ayarlar Butonu -->
                        <Button Style="{StaticResource ModernButton}"
                                Content="⚙️ Ayarlar"
                                Height="28" Padding="11,0" Margin="0,0,10,0"
                                FontSize="11.5"
                                ToolTip="Uygulama Ayarları ve Tercihler"
                                Click="OnOpenSettingsClick"/>

                        <!-- Ayırıcı -->
                        <Border Width="1" Height="18" Background="#1E293B" Margin="0,0,6,0"/>

                        <!-- Pencere Kontrol Düğmeleri -->
                        <Button Style="{StaticResource WindowControlButton}"
                                Content="📌"
                                FontSize="11.5"
                                ToolTip="Sistem Tepsisine Küçült"
                                Click="OnMinimizeToTrayClick"/>

                        <Button Style="{StaticResource WindowControlButton}"
                                Content="─"
                                ToolTip="Simge Durumuna Küçült"
                                Click="OnMinimizeWindowClick"/>

                        <Button x:Name="MaxRestoreBtn"
                                Style="{StaticResource WindowControlButton}"
                                Content="▢"
                                ToolTip="Tam Ekran / Önceki Boyut"
                                Click="OnMaximizeRestoreWindowClick"/>

                        <Button Style="{StaticResource CloseWindowButton}"
                                Content="✕"
                                ToolTip="Kapat"
                                Click="OnCloseWindowClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. ANA İÇERİK ALANI -->
            <Grid Grid.Row="1" Margin="18,14,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- A. YENİ İNDİRME EKLEME ÇUBUĞU (TEK SATIR, TEMİZ) -->
                <Border Grid.Row="0"
                        Background="#0E1525"
                        CornerRadius="11"
                        Padding="12,10"
                        Margin="0,0,0,12"
                        BorderBrush="#1A263D"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- URL Kutusu -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="UrlInputBox"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     Background="#080C16"
                                     Foreground="#F8FAFC"
                                     CaretBrush="#38BDF8"
                                     BorderBrush="#23324B"
                                     BorderThickness="1"
                                     Padding="12,0,80,0"
                                     FontSize="13"
                                     TextChanged="OnUrlInputTextChanged"/>
                            <TextBlock x:Name="UrlPlaceholderText"
                                       Text="İndirilecek video veya dosya bağlantısını yapıştırın (YouTube, HLS, MP4, ZIP)..."
                                       Foreground="#475569"
                                       FontSize="12.5"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="📋 Yapıştır"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Height="28" Padding="8,0" Margin="0,0,6,0"
                                    FontSize="11.5" Foreground="#38BDF8"
                                    Click="OnPasteUrlClick"/>
                        </Grid>

                        <!-- Kalite Seçici -->
                        <ComboBox x:Name="QualityCombo"
                                  Style="{StaticResource DarkComboBox}"
                                  Grid.Column="1"
                                  Width="162" Height="38"
                                  Margin="8,0,0,0"
                                  VerticalContentAlignment="Center"
                                  SelectedIndex="0"
                                  FontSize="12"
                                  ToolTip="Video / Ses Kalitesi">
                            <ComboBoxItem Content="🎬 En İyi Kalite" Tag="best"/>
                            <ComboBoxItem Content="📺 1080p Full HD" Tag="1080"/>
                            <ComboBoxItem Content="📺 720p HD" Tag="720"/>
                            <ComboBoxItem Content="📱 480p SD" Tag="480"/>
                            <ComboBoxItem Content="🎵 Sadece Ses (MP3)" Tag="audio"/>
                        </ComboBox>

                        <!-- İndir Butonu -->
                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Content="⬇ İndir"
                                Height="38" Padding="20,0" Margin="8,0,0,0"
                                FontSize="13"
                                Click="OnStartDownloadClick"/>
                    </Grid>
                </Border>

                <!-- B. FİLTRE SEKMELERİ VE HIZLI ARAÇLAR -->
                <Grid Grid.Row="1" Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Filtre Sekmeleri -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FilterAllBtn"
                                Style="{StaticResource ModernButton}"
                                Content="Tümü"
                                Height="28" Padding="12,0" Margin="0,0,6,0"
                                FontSize="11.5"
                                Tag="all"
                                Click="OnFilterTabClick"/>
                        <Button x:Name="FilterActiveBtn"
                                Style="{StaticResource GhostButton}"
                                Content="Aktif"
                                Height="28" Padding="12,0" Margin="0,0,6,0"
                                FontSize="11.5"
                                Tag="active"
                                Click="OnFilterTabClick"/>
                        <Button x:Name="FilterCompletedBtn"
                                Style="{StaticResource GhostButton}"
                                Content="Tamamlanan"
                                Height="28" Padding="12,0" Margin="0,0,10,0"
                                FontSize="11.5"
                                Tag="completed"
                                Click="OnFilterTabClick"/>

                        <Border Background="#162032" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock x:Name="QueueCountBadge" Text="0 Görev" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <!-- Sağ: Alt Panel Aç/Kapat, Klasör Aç, Temizle -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ToggleSegmentsBtn"
                                Style="{StaticResource GhostButton}"
                                Content="📊 Bağlantı Detayları"
                                Height="28" Padding="10,0" Margin="0,0,4,0"
                                FontSize="11.5"
                                Click="OnToggleSegmentPanelClick"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="📂 Klasörü Aç"
                                Height="28" Padding="10,0" Margin="0,0,4,0"
                                FontSize="11.5"
                                Click="OnOpenDownloadsFolderClick"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="🗑️ Temizle"
                                Height="28" Padding="10,0"
                                FontSize="11.5"
                                Click="OnClearCompletedClick"/>
                    </StackPanel>
                </Grid>

                <!-- C. İNDİRME LİSTESİ (GENİŞ VE FERAH ANA ALAN) -->
                <Border Grid.Row="2"
                        Background="#0B101E"
                        CornerRadius="12"
                        Padding="8"
                        BorderBrush="#162032"
                        BorderThickness="1">
                    <Grid>
                        <ListBox x:Name="DownloadsListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnDownloadSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#11192C"
                                            BorderBrush="#1E293B"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,11"
                                            Margin="2,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Sol: Başlık, İlerleme Çubuğu ve Alt Bilgiler -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <!-- Üst Satır: Kategori Rozeti + Dosya Adı + Yüzde/Hız -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{Binding CategoryBackground}" CornerRadius="4" Padding="6,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CategoryText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13.5"
                                                               Foreground="#F8FAFC"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding SpeedText}" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ProgressPercent, StringFormat=%{0:F1}}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Orta Satır: İlerleme Çubuğu -->
                                                <ProgressBar Style="{StaticResource ModernProgressBar}"
                                                             Value="{Binding ProgressPercent}"
                                                             Maximum="100"
                                                             Foreground="{Binding StatusBrush}"
                                                             Margin="0,0,0,6"/>

                                                <!-- Alt Satır: Durum, Boyut, Kalan Süre -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11.5" Foreground="#94A3B8"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SegmentsSummary}" FontSize="11" Foreground="#64748B" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding EtaText, StringFormat=Kalan: {0}}" FontSize="11" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Sağ: Aksiyon ve Sil Butonları -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ModernButton}"
                                                        Content="{Binding ActionButtonText}"
                                                        Tag="{Binding}"
                                                        Padding="13,7"
                                                        FontSize="12"
                                                        Click="OnItemActionClick"/>
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="✕"
                                                        Tag="{Binding}"
                                                        Padding="8,7"
                                                        Margin="4,0,0,0"
                                                        FontSize="11.5"
                                                        ToolTip="Listeden Kaldır"
                                                        Click="OnRemoveItemClick"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Boş Durum (Empty State) -->
                        <Grid x:Name="EmptyStatePanel" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#162032" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                                          Fill="#38BDF8"
                                          Width="22" Height="22"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Henüz İndirme Yok" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tarayıcıdan bir video/dosya yakalayın veya yukarıya bağlantı yapıştırıp 'İndir'e tıklayın."
                                           FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- D. GİZLENEBİLİR (COLLAPSIBLE) BAĞLANTI & PARÇA DETAY PANELİ (Varsayılan Kapalı) -->
                <Border x:Name="SegmentInspectorPanel"
                        Grid.Row="3"
                        Visibility="Collapsed"
                        Height="165"
                        Background="#0B101E"
                        CornerRadius="11"
                        Padding="12,10"
                        Margin="0,10,0,0"
                        BorderBrush="#162032"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="InspectorTitleText"
                                       Text="📊 Bağlantı ve Akış Detayları"
                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="✕ Gizle"
                                    HorizontalAlignment="Right"
                                    Padding="8,2" FontSize="11"
                                    Click="OnToggleSegmentPanelClick"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SegmentsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11192C"
                                                BorderBrush="#1E293B"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="10,6"
                                                Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat=Akış #{0}}" FontWeight="SemiBold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RangeText}" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Column="2"
                                                             Style="{StaticResource ModernProgressBar}"
                                                             Value="{Binding ProgressPercent}"
                                                             Maximum="100"
                                                             Margin="12,0"
                                                             Foreground="{Binding BarBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DownloadedText}" FontSize="11.5" Foreground="#E2E8F0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding StatusBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding BarBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. AYARLAR (CONFIG) MODAL PANELİ (Ana ekranda yer kaplamaz, ⚙️ Ayarlar'a basınca açılır) -->
            <Grid x:Name="SettingsModalOverlay"
                  Grid.Row="1"
                  Background="#CC050811"
                  Visibility="Collapsed">
                <Border Width="520"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#0F172A"
                        BorderBrush="#23324B"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24,20">
                    <StackPanel>
                        <!-- Başlık -->
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="⚙️ NovaGet Ayarları" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="✕"
                                    HorizontalAlignment="Right"
                                    Padding="8,4" FontSize="13"
                                    Click="OnCloseSettingsClick"/>
                        </DockPanel>

                        <!-- 1. Kayıt Klasörü -->
                        <TextBlock Text="İndirme Kayıt Klasörü" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SettingsDirBox"
                                     Grid.Column="0"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Background="#080C16"
                                     Foreground="#E2E8F0"
                                     BorderBrush="#23324B"
                                     BorderThickness="1"
                                     Padding="10,0"
                                     FontSize="12"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ModernButton}"
                                    Content="📂 Klasörü Aç"
                                    Height="34" Padding="12,0" Margin="8,0,0,0"
                                    FontSize="11.5"
                                    Click="OnOpenDownloadsFolderClick"/>
                        </Grid>

                        <!-- 2. Varsayılan Bağlantı Sayısı & Varsayılan Kalite -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Paralel Bağlantı Sayısı (Hızlandırma)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <ComboBox x:Name="SettingsConnectionsCombo"
                                          Style="{StaticResource DarkComboBox}"
                                          Height="36"
                                          SelectedIndex="2"
                                          FontSize="12.5">
                                    <ComboBoxItem Content="1 Bağlantı (Standart)" Tag="1"/>
                                    <ComboBoxItem Content="4 Bağlantı (Hızlı)" Tag="4"/>
                                    <ComboBoxItem Content="8 Bağlantı (Önerilen)" Tag="8"/>
                                    <ComboBoxItem Content="16 Bağlantı (Yüksek Hız)" Tag="16"/>
                                    <ComboBoxItem Content="32 Bağlantı (Maksimum)" Tag="32"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Varsayılan Video Kalitesi" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <ComboBox x:Name="SettingsQualityCombo"
                                          Style="{StaticResource DarkComboBox}"
                                          Height="36"
                                          SelectedIndex="0"
                                          FontSize="12.5">
                                    <ComboBoxItem Content="🎬 En İyi Kalite (4K/1080p)" Tag="best"/>
                                    <ComboBoxItem Content="📺 1080p Full HD" Tag="1080"/>
                                    <ComboBoxItem Content="📺 720p HD" Tag="720"/>
                                    <ComboBoxItem Content="📱 480p SD" Tag="480"/>
                                    <ComboBoxItem Content="🎵 Sadece Ses (MP3)" Tag="audio"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 3. Uygulama Davranışı -->
                        <TextBlock Text="Genel Tercihler" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Border Background="#0B101E" BorderBrush="#1A263D" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="MinimizeToTrayCheck"
                                          Content="Pencere kapatıldığında (X) Sistem Tepsisine (System Tray) küçült"
                                          IsChecked="True"
                                          Foreground="#E2E8F0"
                                          FontSize="12.5"
                                          Margin="0,0,0,10"
                                          Cursor="Hand"/>
                                <CheckBox x:Name="NotifyOnCompleteCheck"
                                          Content="İndirme tamamlandığında masaüstü bildirimi göster"
                                          IsChecked="True"
                                          Foreground="#E2E8F0"
                                          FontSize="12.5"
                                          Margin="0,0,0,10"
                                          Cursor="Hand"/>
                                <CheckBox x:Name="AutoStartBrowserCheck"
                                          Content="Tarayıcı eklentisinden gelen indirmeleri otomatik başlat"
                                          IsChecked="True"
                                          Foreground="#E2E8F0"
                                          FontSize="12.5"
                                          Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Tanılama & Hız Testi Araçları -->
                        <TextBlock Text="Tanılama ve Test Araçları" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Style="{StaticResource ModernButton}"
                                    Content="⚡ 128 MB Hız Testi Başlat"
                                    Height="32" Padding="12,0" Margin="0,0,8,0"
                                    FontSize="11.5"
                                    Click="OnStart128MbDemoClick"/>
                            <Button Style="{StaticResource ModernButton}"
                                    Content="🎬 HLS (.m3u8) Akış Testi"
                                    Height="32" Padding="12,0"
                                    FontSize="11.5"
                                    Click="OnStartHlsDemoClick"/>
                        </StackPanel>

                        <!-- Kaydet Butonu -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="✓ Ayarları Kaydet"
                                Height="38"
                                FontSize="13"
                                Click="OnSaveSettingsClick"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
